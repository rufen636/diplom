{
    "openapi": "3.0.0",
    "info": {
        "title": "Diplom API",
        "description": "Документация по основным роутам менеджера",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Основной сервер"
        }
    ],
    "paths": {
        "/manager/tariffs": {
            "get": {
                "tags": [
                    "Tariffs"
                ],
                "summary": "Список тарифов",
                "operationId": "getTariffsList",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешно"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Tariffs"
                ],
                "summary": "Создать тариф",
                "operationId": "storeTariff",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "price",
                                    "speed",
                                    "duration_months"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Тариф Старт"
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 999.99
                                    },
                                    "speed": {
                                        "type": "integer",
                                        "example": 100
                                    },
                                    "duration_months": {
                                        "type": "integer",
                                        "example": 12
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Редирект после создания"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/manager/contracts": {
            "get": {
                "tags": [
                    "Contracts"
                ],
                "summary": "Список договоров",
                "operationId": "getContractsList",
                "responses": {
                    "200": {
                        "description": "Успешно"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Contracts"
                ],
                "summary": "Создать договор",
                "operationId": "storeContract",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "contract_number",
                                    "title",
                                    "user_id",
                                    "start_date",
                                    "end_date",
                                    "amount",
                                    "status"
                                ],
                                "properties": {
                                    "contract_number": {
                                        "type": "string",
                                        "example": "CTR-2026-001"
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Договор услуг"
                                    },
                                    "user_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-01-01"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-12-31"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 15000
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "active"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Редирект после создания"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/manager/provider-clients": {
            "get": {
                "tags": [
                    "ProviderClients"
                ],
                "summary": "Список клиентов провайдера",
                "operationId": "getProviderClientsList",
                "responses": {
                    "200": {
                        "description": "Успешно"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "ProviderClients"
                ],
                "summary": "Создать клиента провайдера",
                "operationId": "storeProviderClient",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "contact_person",
                                    "email",
                                    "phone",
                                    "type",
                                    "status"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "ООО Альфа"
                                    },
                                    "contact_person": {
                                        "type": "string",
                                        "example": "Иванов И.И."
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "alpha@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+79990001122"
                                    },
                                    "type": {
                                        "type": "string",
                                        "example": "company"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "active"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Редирект после создания"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/tariffs": {
            "get": {
                "tags": [
                    "TariffsJsonApi"
                ],
                "summary": "Список тарифов (JSON)",
                "operationId": "apiV1TariffsIndex",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "price": {
                                                        "type": "number",
                                                        "format": "float"
                                                    },
                                                    "speed": {
                                                        "type": "integer"
                                                    },
                                                    "duration_months": {
                                                        "type": "integer"
                                                    },
                                                    "is_active": {
                                                        "type": "boolean"
                                                    },
                                                    "user_id": {
                                                        "type": "integer"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "TariffsJsonApi"
                ],
                "summary": "Создать тариф (JSON)",
                "operationId": "apiV1TariffsStore",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "price",
                                    "speed",
                                    "duration_months"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Тариф API"
                                    },
                                    "description": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 890
                                    },
                                    "speed": {
                                        "type": "integer",
                                        "example": 200
                                    },
                                    "duration_months": {
                                        "type": "integer",
                                        "example": 6
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "sort_order": {
                                        "type": "integer",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Создано"
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/tariffs/{tariff}": {
            "delete": {
                "tags": [
                    "TariffsJsonApi"
                ],
                "summary": "Удалить тариф (JSON)",
                "operationId": "apiV1TariffsDestroy",
                "parameters": [
                    {
                        "name": "tariff",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Удалено"
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "403": {
                        "description": "Чужой тариф"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "TariffsJsonApi"
                ],
                "summary": "Обновить тариф (JSON)",
                "operationId": "apiV1TariffsUpdate",
                "parameters": [
                    {
                        "name": "tariff",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "price",
                                    "speed",
                                    "duration_months"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float"
                                    },
                                    "speed": {
                                        "type": "integer"
                                    },
                                    "duration_months": {
                                        "type": "integer"
                                    },
                                    "is_active": {
                                        "type": "boolean"
                                    },
                                    "sort_order": {
                                        "type": "integer",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "403": {
                        "description": "Чужой тариф"
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
